[Unit]
Description=drm-gamma notification Service
Documentation=https://github.com/ealtun21/drm-gamma
After=graphical.target

[Service]
Type=simple
ExecStart=/usr/local/bin/drm-gamma-notifier.sh
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

# Run as root (needs to switch to user context for notifications)
User=root

[Install]
WantedBy=graphical.target
